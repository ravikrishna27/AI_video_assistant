# ==========================================
# AI Video Assistant - Environment Variables
# ==========================================

# Required: Mistral AI API key for summarization, title generation, and RAG Q&A
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Sarvam AI API key for Hinglish / Indic speech-to-text translation
# Get your key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional model configurations (defaults shown below)
WHISPER_MODEL=small
SARVAM_STT_MODEL=saaras:v2.5
